# Rust main task needs a bigger stack than the default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_FREERTOS_HZ=1000

# ESP32-S3-WROOM-1-N16R8: 16 MB quad flash + 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Console on the native USB (USB-Serial/JTAG): UART0 pins IO43/IO44 go to the
# J4 header and stay free for the loopback test.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Wi-Fi + std pull the app past the default 1 MB factory partition. Absolute
# path: ESP-IDF resolves it relative to its generated build dir.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="C:/Users/gravi/Documents/auto_probe/firmware/voiceunit-test/partitions.csv"

# Web page from phones/laptops: browsers send long request headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Ключевое слово «Sophia»: модель WakeNet9 в разделе flash "model" (partitions.csv),
# прошивается отдельно файлом srmodels.bin. Нужна PSRAM (выше).
CONFIG_SR_WN_WN9_SOPHIA_TTS=y
CONFIG_MODEL_IN_FLASH=y

# Внутренней RAM на стеки задач не хватало ("pthread: Failed to create task!"):
# буферы Wi-Fi и lwIP - в PSRAM, внутренняя память остаётся задачам и AFE.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# USB-колонка с микрофоном: 16 кГц, 16 бит, моно в обе стороны - как остальной
# звук платы (динамик и микрофоны работают на 16 кГц).
CONFIG_UAC_SAMPLE_RATE=16000
CONFIG_UAC_SPEAKER_CHANNEL_NUM=1
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_BIT_RESOLUTION_16=y
# Так плата называется в «Звуке» Windows.
CONFIG_UAC_TUSB_MANUFACTURER="voice_cell"
CONFIG_UAC_TUSB_PRODUCT="Voice Cell"
CONFIG_UAC_TUSB_SERIAL_NUM="voicecell1"
